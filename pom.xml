<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot parent gives us tested dependency versions for every module. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.swipehire</groupId>
    <artifactId>swipehire-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>SwipeHire</name>

    <modules>
        <module>swipehire-common</module>
        <module>swipehire-engine</module>
        <module>swipehire-web</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lucene.version>9.11.1</lucene.version>
        <openpdf.version>2.0.3</openpdf.version>
        <pdfbox.version>3.0.3</pdfbox.version>
        <jfreechart.version>1.5.5</jfreechart.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.swipehire</groupId>
                <artifactId>swipehire-common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
