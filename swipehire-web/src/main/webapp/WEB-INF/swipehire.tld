<?xml version="1.0" encoding="UTF-8"?>
<!-- Custom EL functions for SwipeHire JSPs. Implemented in com.swipehire.web.support.JspFunctions. -->
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_0.xsd"
        version="3.0">
    <tlib-version>1.0</tlib-version>
    <short-name>f</short-name>
    <uri>urn:swipehire:functions</uri>

    <function>
        <name>date</name>
        <function-class>com.swipehire.web.support.JspFunctions</function-class>
        <function-signature>java.lang.String date(java.lang.Object)</function-signature>
    </function>
    <function>
        <name>dateTime</name>
        <function-class>com.swipehire.web.support.JspFunctions</function-class>
        <function-signature>java.lang.String dateTime(java.lang.Object)</function-signature>
    </function>
    <function>
        <name>isoLocal</name>
        <function-class>com.swipehire.web.support.JspFunctions</function-class>
        <function-signature>java.lang.String isoLocal(java.lang.Object)</function-signature>
    </function>
    <function>
        <name>ago</name>
        <function-class>com.swipehire.web.support.JspFunctions</function-class>
        <function-signature>java.lang.String ago(java.lang.Object)</function-signature>
    </function>
    <function>
        <name>daysUntil</name>
        <function-class>com.swipehire.web.support.JspFunctions</function-class>
        <function-signature>long daysUntil(java.lang.Object)</function-signature>
    </function>
    <function>
        <name>money</name>
        <function-class>com.swipehire.web.support.JspFunctions</function-class>
        <function-signature>java.lang.String money(java.lang.Integer)</function-signature>
    </function>
    <function>
        <name>pct</name>
        <function-class>com.swipehire.web.support.JspFunctions</function-class>
        <function-signature>long pct(java.lang.Double)</function-signature>
    </function>
    <function>
        <name>initials</name>
        <function-class>com.swipehire.web.support.JspFunctions</function-class>
        <function-signature>java.lang.String initials(java.lang.String)</function-signature>
    </function>
    <function>
        <name>title</name>
        <function-class>com.swipehire.web.support.JspFunctions</function-class>
        <function-signature>java.lang.String title(java.lang.Object)</function-signature>
    </function>
</taglib>
